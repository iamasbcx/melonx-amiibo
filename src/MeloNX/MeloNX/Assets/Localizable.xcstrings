          }
        }
      }
    },
    "Global Defaults": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全局默认"
          }
        }
      }
    },
    "Current-game values override global defaults for each setting. Global changes apply wherever the game has no override.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前游戏按参数优先使用专属设置；未单独设置的参数跟随全局默认。"
          }
        }
      }
    },
    "Camera and Phone Motion": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视角与手机运动"
          }
        }
      }
    },
    "Virtual Controller Appearance": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "虚拟手柄"
          }
        }
      }
    },
    "Edit the controller layout to change button positions, grid snapping, and the right stick or swipe-area size and visibility.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在布局编辑中调整按钮位置、网格吸附，以及右摇杆和滑动视角区域的大小与显隐。"
          }
        }
      }
    },
    "Use Global Input Defaults": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用全局输入默认值"
          }
        }
      }
    },
    "Use Global Input Defaults?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要恢复使用全局输入默认值吗？"
          }
        }
      }
    },
    "Removes only this game's input overrides shown on this page. Other game settings and controller layouts are kept.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅移除此页所示的当前游戏输入设置，其他游戏设置和手柄布局保持原样。"
          }
        }
      }
    },
