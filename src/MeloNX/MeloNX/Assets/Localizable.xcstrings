    },
    "Try 2–3x if swiping feels slow. 1x is the original speed; 0.5x gives finer control.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑动偏慢时建议从 2～3 倍开始调整。1 倍为原速，0.5 倍适合精细瞄准。"
          }
        }
      }
    },
    "Range: 0.25–9999x. Tap Apply to save. High values reach the game's right-stick speed limit sooner; 9999x does not mean 9999 times the turning speed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "范围：0.25～9999 倍，点击“应用”保存。高倍率更容易达到游戏的右摇杆速度上限，9999 倍不代表转向速度变成 9999 倍。"
          }
        }
      }
    },
    "Enter a sensitivity multiplier.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入灵敏度倍数。"
          }
        }
      }
    },
    "Enter a valid decimal number, such as 2.5.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效的小数，例如 2.5。"
          }
        }
      }
    },
    "Enter a multiplier from 0.25 to 9999.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 0.25～9999 之间的倍数。"
