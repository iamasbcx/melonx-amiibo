    "Phone Motion Directions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机运动方向"
          }
        }
      }
    },
    "Enable or reverse each phone movement independently. Disabled directions keep their reverse setting for later use.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个方向可独立启用或反向。关闭方向后会保留反向设置，方便下次启用。"
          }
