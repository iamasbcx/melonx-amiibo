          "stringUnit": {
            "state": "translated",
            "value": "保存备注"
          }
        }
      }
    },
    "Shown below the game name and developer. Leave empty to hide the note. Up to 500 characters.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示在游戏名和公司名下方。清空并保存即可隐藏备注，最多 500 字。"
          }
        }
      }
